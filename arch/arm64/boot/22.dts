			pinctrl-1 = <0x134>;

			vol_up {
				label = "volume_up";
				gpios = <0x74 0x6b 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x73>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
			};

			home_key {
				label = "home";
				gpios = <0x74 0x6c 0x1>;
				linux,input-type = <0x1>;
				linux,code = <0x66>;
				gpio-key,wakeup;
				debounce-interval = <0xf>;
