						function = "blsp_i2c6";
					};

					config {
						pins = "gpio22", "gpio23";
						drive-strength = <0x2>;
						bias-disable;
					};
				};

				i2c_6_sleep {
					linux,phandle = <0xaa>;
					phandle = <0xaa>;

					mux {
						pins = "gpio22", "gpio23";
						function = "blsp_i2c6";
					};

					config {
						pins = "gpio22", "gpio23";
