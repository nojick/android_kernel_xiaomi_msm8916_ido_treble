/dts-v1/;

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	interrupt-parent = <0x1>;
	model = "Qualcomm Technologies, Inc. MSM8939v3.0 QRD SKUK";
	compatible = "qcom,msm8939-qrd-ido", "qcom,msm8939-qrd", "qcom,msm8939", "qcom,qrd";
	qcom,msm-id = <0xef 0x30000 0xf1 0x30000 0x107 0x30000>;
	qcom,board-id = <0x1000b 0xb 0x2000b 0xb>;

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x2>;
				};

				core1 {
					cpu = <0x3>;
				};

				core2 {
					cpu = <0x4>;
				};

				core3 {
					cpu = <0x5>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x6>;
				};

				core1 {
					cpu = <0x7>;
				};

				core2 {
					cpu = <0x8>;
				};

				core3 {
					cpu = <0x9>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x100>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0xa>;
			next-level-cache = <0xb>;
			linux,phandle = <0x6>;
			phandle = <0x6>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x2>;
				power-domain = <0xc>;
				linux,phandle = <0xb>;
				phandle = <0xb>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x101>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0xd>;
			next-level-cache = <0xb>;
			linux,phandle = <0x7>;
			phandle = <0x7>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x102>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0xe>;
			next-level-cache = <0xb>;
			linux,phandle = <0x8>;
			phandle = <0x8>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x103>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0xf>;
			next-level-cache = <0xb>;
			linux,phandle = <0x9>;
			phandle = <0x9>;
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x0>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x10>;
			next-level-cache = <0x11>;
			linux,phandle = <0x2>;
			phandle = <0x2>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x2>;
				power-domain = <0x12>;
				linux,phandle = <0x11>;
				phandle = <0x11>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x1>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x13>;
			next-level-cache = <0x11>;
			linux,phandle = <0x3>;
			phandle = <0x3>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x2>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x14>;
			next-level-cache = <0x11>;
			linux,phandle = <0x4>;
			phandle = <0x4>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			clock-frequency = <0x124f800>;
			reg = <0x3>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x15>;
			next-level-cache = <0x11>;
			linux,phandle = <0x5>;
			phandle = <0x5>;
		};
	};

	soc {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x0 0x0 0xffffffff>;
		compatible = "simple-bus";

		qcom,ipc_router {
			compatible = "qcom,ipc_router";
			qcom,node-id = <0x1>;
		};

		qcom,ipc_router_modem_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "modem";
			qcom,xprt-linkid = <0x1>;
			qcom,xprt-version = <0x1>;
			qcom,fragmented-data;
			qcom,disable-pil-loading;
		};

		qcom,ipc_router_wcnss_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "wcnss";
			qcom,xprt-linkid = <0x1>;
			qcom,xprt-version = <0x1>;
			qcom,fragmented-data;
		};

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			qcom,ion-heap@25 {
				reg = <0x19>;
				qcom,ion-heap-type = "SYSTEM";
			};

			qcom,ion-heap@8 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x8>;
				qcom,heap-align = <0x1000>;
				linux,contiguous-region = <0x16>;
				qcom,ion-heap-type = "SECURE_DMA";
			};

			qcom,ion-heap@27 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1b>;
				linux,contiguous-region = <0x17>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@28 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1c>;
				linux,contiguous-region = <0x18>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@23 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x17>;
				linux,contiguous-region = <0x19>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@26 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1a>;
				linux,contiguous-region = <0x1a>;
				qcom,ion-heap-type = "DMA";
			};
		};

		qcom,gdsc@184c018 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus";
			reg = <0x184c018 0x4>;
			status = "okay";
			clock-names = "bus_clk", "core_clk";
			clocks = <0x1b 0xcdf4c8f6 0x1b 0xf76a02bb>;
			linux,phandle = <0xeb>;
			phandle = <0xeb>;
		};

		qcom,gdsc@184d078 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_mdss";
			reg = <0x184d078 0x4>;
			status = "okay";
			clock-names = "core_clk", "bus_clk";
			clocks = <0x1b 0x22f3521f 0x1b 0x668f51de>;
			linux,phandle = <0x68>;
			phandle = <0x68>;
		};

		qcom,gdsc@185701c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_jpeg";
			reg = <0x185701c 0x4>;
			status = "okay";
			clock-names = "core_clk", "bus_clk";
			clocks = <0x1b 0x1ed3f032 0x1b 0x3e278896>;
			linux,phandle = <0x82>;
			phandle = <0x82>;
		};

		qcom,gdsc@1858034 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vfe";
			reg = <0x1858034 0x4>;
			status = "okay";
			clock-names = "core_clk", "bus_clk", "micro_clk", "cpp_clk", "csi_clk";
			clocks = <0x1b 0xaaa3cd97 0x1b 0x77fe2384 0x1b 0xfbbee8cf 0x1b 0x7118a0de 0x1b 0xcc73453c>;
			linux,phandle = <0x81>;
			phandle = <0x81>;
		};

		qcom,gdsc@185901c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_gx";
			reg = <0x185901c 0x4>;
			status = "okay";
			clock-names = "core_root_clk", "core_clk", "gmem_clk";
			clocks = <0x1b 0x917f76ef 0x1b 0x49a51fd9 0x1b 0x5620913a>;
			qcom,enable-root-clk;
			linux,phandle = <0x12e>;
			phandle = <0x12e>;
		};

		qcom,gdsc@184c028 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core0";
			reg = <0x184c028 0x4>;
			status = "okay";
			qcom,support-hw-trigger;
			clock-names = "core0_clk";
			clocks = <0x1b 0x83a7f549>;
			linux,phandle = <0xf2>;
			phandle = <0xf2>;
		};

		qcom,gdsc@184c030 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core1";
			reg = <0x184c030 0x4>;
			status = "okay";
			qcom,support-hw-trigger;
			clock-names = "core1_clk";
			clocks = <0x1b 0xa0813de6>;
			linux,phandle = <0xf3>;
			phandle = <0xf3>;
		};

		qcom,iommu@1f00000 {
			compatible = "qcom,msm-smmu-v2", "qcom,msm-mmu-500";
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges;
			reg = <0x1f00000 0x10000>;
			reg-names = "iommu_base";
			interrupts = <0x0 0x2b 0x0 0x0 0x2a 0x0>;
			interrupt-names = "global_cfg_NS_irq", "global_cfg_S_irq";
			label = "gfx_iommu";
			qcom,iommu-secure-id = <0x12>;
			clocks = <0x1b 0x75eaefa5 0x1b 0x59505e55>;
			clock-names = "iface_clk", "core_clk";
			status = "ok";
			linux,phandle = <0x12f>;
			phandle = <0x12f>;

			qcom,iommu-ctx@1f09000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1f09000 0x1000>;
				interrupts = <0x0 0xf1 0x0>;
				qcom,iommu-ctx-sids = <0x0>;
				label = "gfx3d_user";
			};

			qcom,iommu-ctx@1f0a000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1f0a000 0x1000>;
				interrupts = <0x0 0xf2 0x0>;
				qcom,iommu-ctx-sids = <0x1>;
				label = "gfx3d_priv";
			};
		};

		qcom,iommu@1e00000 {
			compatible = "qcom,msm-smmu-v2", "qcom,msm-mmu-500";
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges;
			reg = <0x1e00000 0x40000>;
			reg-names = "iommu_base";
			interrupts = <0x0 0x2b 0x0 0x0 0x2a 0x0>;
			interrupt-names = "global_cfg_NS_irq", "global_cfg_S_irq";
			label = "apps_iommu";
			qcom,iommu-secure-id = <0x11>;
			clocks = <0x1b 0x75eaefa5 0x1b 0xaf56a329>;
			clock-names = "iface_clk", "core_clk";
			qcom,cb-base-offset = <0x20000>;
			status = "ok";

			qcom,iommu-ctx@1e22000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e22000 0x1000>;
				interrupts = <0x0 0x35 0x0>;
				qcom,iommu-ctx-sids = <0x2000>;
				label = "jpeg_enc0";
			};

			qcom,iommu-ctx@1e23000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e23000 0x1000>;
				interrupts = <0x0 0x36 0x0>;
				qcom,iommu-ctx-sids = <0x400>;
				label = "vfe";
			};

			qcom,iommu-ctx@1e24000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e24000 0x1000>;
				interrupts = <0x0 0x3a 0x0>;
				qcom,iommu-ctx-sids = <0xc00 0x2800>;
				label = "mdp_0";
			};

			qcom,iommu-ctx@1e25000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e25000 0x1000>;
				interrupts = <0x0 0x3c 0x0>;
				qcom,iommu-ctx-sids = <0x800 0x801 0x802 0x803 0x804 0x805 0x807>;
				label = "venus_ns";
				qcom,report-error-on-fault;
				linux,phandle = <0x7d>;
				phandle = <0x7d>;
			};

			qcom,iommu-ctx@1e26000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e26000 0x1000>;
				interrupts = <0x0 0x3d 0x0>;
				qcom,iommu-ctx-sids = <0x2400>;
				label = "cpp";
			};

			qcom,iommu-ctx@1e27000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e27000 0x1000>;
				interrupts = <0x0 0x4c 0x0>;
				qcom,iommu-ctx-sids = <0x1000>;
				label = "mDSP";
			};

			qcom,iommu-ctx@1e28000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e28000 0x1000>;
				interrupts = <0x0 0x4d 0x0>;
				qcom,iommu-ctx-sids = <0x1400>;
				label = "gss";
			};

			qcom,iommu-ctx@1e29000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e29000 0x1000>;
				interrupts = <0x0 0x50 0x0>;
				qcom,iommu-ctx-sids = <0x1800>;
				label = "a2";
			};

			qcom,iommu-ctx@1e32000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e32000 0x1000>;
				interrupts = <0x0 0x6e 0x0 0x0 0x6e 0x0>;
				qcom,iommu-ctx-sids = <0xc01 0x2801>;
				label = "mdp_1";
			};

			qcom,iommu-ctx@1e33000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e33000 0x1000>;
				interrupts = <0x0 0x6f 0x0 0x0 0x6f 0x0>;
				qcom,iommu-ctx-sids = <0x885>;
				label = "venus_sec_pixel";
				qcom,report-error-on-fault;
				linux,phandle = <0x7f>;
				phandle = <0x7f>;
			};

			qcom,iommu-ctx@1e34000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e34000 0x1000>;
				interrupts = <0x0 0x70 0x0 0x0 0x70 0x0>;
				qcom,iommu-ctx-sids = <0x880 0x881 0x882 0x883 0x884>;
				label = "venus_sec_bitstream";
				qcom,report-error-on-fault;
				linux,phandle = <0x7e>;
				phandle = <0x7e>;
			};

			qcom,iommu-ctx@1e35000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e35000 0x1000>;
				interrupts = <0x0 0x71 0x0 0x0 0x71 0x0>;
				qcom,iommu-ctx-sids = <0x887 0x8a0>;
				label = "venus_sec_non_pixel";
				qcom,report-error-on-fault;
				linux,phandle = <0x80>;
				phandle = <0x80>;
			};

			qcom,iommu-ctx@1e36000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e36000 0x1000>;
				interrupts = <0x0 0x72 0x0 0x0 0x72 0x0>;
				qcom,iommu-ctx-sids = <0x8c0 0x8c6>;
				label = "venus_fw";
				qcom,report-error-on-fault;
			};

			qcom,iommu-ctx@1e37000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e37000 0x1000>;
				interrupts = <0x0 0x73 0x0 0x0 0x73 0x0>;
				qcom,iommu-ctx-sids = <0x40>;
				label = "periph_rpm";
			};

			qcom,iommu-ctx@1e38000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e38000 0x1000>;
				interrupts = <0x0 0x74 0x0>;
				qcom,iommu-ctx-sids = <0xc0 0xc4 0xc8 0xcc 0xd0 0xd3 0xd4 0xd7 0xd8 0xdb 0xdc 0xdf 0xf0 0xf3 0xf4 0xf7 0xf8 0xfb 0xfc 0xff>;
				label = "periph_CE";
			};

			qcom,iommu-ctx@1e39000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e39000 0x1000>;
				interrupts = <0x0 0x75 0x0>;
				qcom,iommu-ctx-sids = <0x280 0x283 0x284 0x287 0x288 0x28b 0x28c 0x28f 0x290 0x293 0x294 0x297 0x298 0x29b 0x29c 0x29f>;
				label = "periph_BLSP";
			};

			qcom,iommu-ctx@1e3a000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3a000 0x1000>;
				interrupts = <0x0 0x76 0x0>;
				qcom,iommu-ctx-sids = <0x100>;
				label = "periph_SDC1";
			};

			qcom,iommu-ctx@1e3b000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3b000 0x1000>;
				interrupts = <0x0 0x77 0x0>;
				qcom,iommu-ctx-sids = <0x140>;
				label = "periph_SDC2";
			};

			qcom,iommu-ctx@1e3c000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3c000 0x1000>;
				interrupts = <0x0 0x78 0x0>;
				qcom,iommu-ctx-sids = <0x1c0>;
				label = "periph_audio";
			};

			qcom,iommu-ctx@1e3d000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3d000 0x1000>;
				interrupts = <0x0 0x79 0x0>;
				qcom,iommu-ctx-sids = <0x2c0>;
				label = "periph_USB_HS1";
			};
		};

		static-rules {
			compatible = "qcom,msm-bus-static-bw-rules";

			rule0 {
				qcom,src-nodes = <0x1c>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x0>;
				qcom,thresh = <0x2a3000>;
				qcom,mode = <0x0>;
				qcom,dest-node = <0x1c>;
				qcom,dest-bw = <0x10c8e0>;
			};

			rule1 {
				qcom,src-nodes = <0x1c>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x0>;
				qcom,thresh = <0x558c00>;
				qcom,mode = <0x0>;
				qcom,dest-node = <0x1c>;
				qcom,dest-bw = <0x186a00>;
			};

			rule2 {
				qcom,src-nodes = <0x1c>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x3>;
				qcom,thresh = <0x558c00>;
				qcom,mode = <0x1>;
				qcom,dest-node = <0x1c>;
			};

			rule3 {
				qcom,src-nodes = <0x1d>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x0>;
				qcom,thresh = <0x2a3000>;
				qcom,mode = <0x0>;
				qcom,dest-node = <0x1d>;
				qcom,dest-bw = <0xf4240>;
			};

			rule4 {
				qcom,src-nodes = <0x1d>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x0>;
				qcom,thresh = <0x558c00>;
				qcom,mode = <0x0>;
				qcom,dest-node = <0x1d>;
				qcom,dest-bw = <0x1e8480>;
			};

			rule5 {
				qcom,src-nodes = <0x1d>;
				qcom,src-field = <0x0>;
				qcom,src-op = <0x3>;
				qcom,thresh = <0x558c00>;
				qcom,mode = <0x1>;
				qcom,dest-node = <0x1d>;
			};
		};

		ad-hoc-bus@580000 {
			compatible = "qcom,msm-bus-device";
			reg = <0x580000 0x14080 0x580000 0x14080 0x400000 0x62000 0x500000 0x11000>;
			reg-names = "snoc-base", "snoc-mm-base", "bimc-base", "pnoc-base";

			fab-snoc {
				cell-id = <0x400>;
